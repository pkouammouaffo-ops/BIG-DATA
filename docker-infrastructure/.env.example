# ========================================
# VARIABLES D'ENVIRONNEMENT - PROJET CHU
# FICHIER EXEMPLE — Copier en .env et remplir les valeurs
# ========================================
# ⚠️ NE PAS COMMITER .env (uniquement .env.example)

# ========================================
# RÉSEAU DOCKER
# ========================================
NETWORK_NAME=chu_network

# ========================================
# HDFS
# ========================================
CLUSTER_NAME=chu_cluster
HDFS_REPLICATION_FACTOR=3
HDFS_NAMENODE_PORT=9000
HDFS_NAMENODE_HTTP_PORT=9870

# ========================================
# SPARK
# ========================================
SPARK_MASTER_HOST=chu-spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8888
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# ========================================
# POSTGRESQL
# ========================================
POSTGRES_HOST=chu-postgres
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB_SIH=sih_data
POSTGRES_DB_AIRFLOW=airflow_db
POSTGRES_DB_METASTORE=metastore_db

# ========================================
# HIVE
# ========================================
HIVE_SERVER_PORT=10000
HIVE_METASTORE_PORT=9083
HIVE_WEBUI_PORT=10002

# ========================================
# NIFI
# ========================================
NIFI_WEB_HTTP_PORT=9090
NIFI_USERNAME=admin
NIFI_PASSWORD=CHANGE_ME

# ========================================
# AIRFLOW
# ========================================
AIRFLOW_WEBUI_PORT=8085
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=CHANGE_ME
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_FERNET_KEY=GENERATE_WITH: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ========================================
# CHEMINS LOCAUX (adapter à votre machine)
# ========================================
PROJECT_ROOT=C:/Users/VOTRE_NOM/VOTRE_CHEMIN/Projet_cloud_healthcare_unit
DATA_FOLDER=${PROJECT_ROOT}/DATA 2024/DATA 2024
AIRFLOW_DAGS_FOLDER=${PROJECT_ROOT}/docker-infrastructure/airflow/dags
AIRFLOW_LOGS_FOLDER=${PROJECT_ROOT}/docker-infrastructure/airflow/logs
